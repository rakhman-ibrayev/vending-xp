{
  "expo": {
    "name": "vending",
    "slug": "vending",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vending",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.rakhmanxibrayev.vending"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4724abbe-9ced-41cd-9b43-51e1634c8703"
      }
    },
    "owner": "rakhmanxibrayev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4724abbe-9ced-41cd-9b43-51e1634c8703"
    }
  }
}
